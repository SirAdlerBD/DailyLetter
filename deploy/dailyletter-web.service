# De web-app. Installeer als gebruikersdienst:
#   cp deploy/dailyletter-*.{service,timer} ~/.config/systemd/user/
#   systemctl --user daemon-reload
#   systemctl --user enable --now dailyletter-web.service dailyletter-run.timer
# %h is je thuismap, dus er staat geen gebruikersnaam of pad vast in dit bestand.

[Unit]
Description=DailyLetter web-app
After=network-online.target

[Service]
WorkingDirectory=%h/DailyLetter
ExecStart=%h/DailyLetter/.venv/bin/dailyletter serve
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
