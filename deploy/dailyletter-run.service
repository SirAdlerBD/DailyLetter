# De batchjob: maakt één briefje voor elke gebruiker en stopt dan.
# Welke versie (ochtend, middag, vooravond, avond) volgt uit het uur.

[Unit]
Description=DailyLetter batchjob
After=network-online.target

[Service]
Type=oneshot
WorkingDirectory=%h/DailyLetter
ExecStart=%h/DailyLetter/.venv/bin/dailyletter run
