# Kopieer naar .env en vul in. Dit bestand hoort nooit in git.

# Waar de database en de foto's staan.
DAILYLETTER_DATA_DIR=./data

# Sleutel waarmee persoonlijke koppelingen (zoals je iCal-adres) versleuteld worden.
# Maak er een met: dailyletter gen-key
DAILYLETTER_SECRET_KEY=

# Standaard tijdzone voor nieuwe gebruikers.
DAILYLETTER_TIMEZONE=Europe/Brussels

# Waar de web-app luistert. Alleen lokaal: Tailscale zet dit door naar je toestellen.
DAILYLETTER_HOST=127.0.0.1
DAILYLETTER_PORT=8321

# Taalmodel (vanaf fase 2). Zonder sleutel schrijft het briefje in sjabloonzinnen.
OPENAI_API_KEY=
OPENAI_MODEL=

# Meldingen op je gsm. Maak de sleutel met: dailyletter gen-vapid --contact mailto:jij@voorbeeld.be
# Het contactadres krijgen Apple en Google te zien, voor als er iets misloopt.
DAILYLETTER_VAPID_PRIVATE=
DAILYLETTER_VAPID_CONTACT=
